# CUDA-only R2T2 service. Copy to .env before deployment.
ASR_PORT=4174
ASR_GPU=0
# API_KEY=your_api_key_here
# R2T2_INTERNAL_TOKEN=your_internal_token_here

# Prepare models with ./scripts/prepare-models.sh before starting the container.
# Nemotron is mounted read-only; other missing models can download on startup.
# Set offline mode after preparing the mounted model cache.
HF_HUB_OFFLINE=0
# HF_ENDPOINT=https://hf-mirror.com

# One shared R2T2 engine and the aligner share one GPU. Budget total VRAM.
R2T2_GPU_MEMORY_UTILIZATION=0.30
FORCED_ALIGNER_GPU_MEMORY_UTILIZATION=0.15
R2T2_MAX_SESSIONS=4
R2T2_MAX_MODEL_LEN=16384
R2T2_ENFORCE_EAGER=0
