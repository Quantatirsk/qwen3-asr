# Qwen3-ASR environment
# Copy to .env and edit only the values you need to change.

# -----------------------------------------------------------------------------
# Public endpoint and auth.
# -----------------------------------------------------------------------------
# NGINX_PORT controls the host port used by docker-compose.
NGINX_PORT=17003

# Leave empty to disable authentication.
# API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Runtime selection.
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0

# Ascend split-runtime deployment.
# QWEN_VLLM_BASE_URL=http://qwen-npu:8000
# QWEN_VLLM_SERVED_MODEL=qwen3-asr
# QWEN_VLLM_TIMEOUT_SEC=3600
# SPEAKER_DIARIZATION_DEVICE=cpu
# VLLM_ASCEND_IMAGE=quay.io/ascend/vllm-ascend:v0.22.1rc1
# QWEN_ASCEND_MODEL_PATH=Qwen/Qwen3-ASR-1.7B
# QWEN_ASCEND_MAX_MODEL_LEN=4096
# QWEN_ASCEND_MEMORY_UTILIZATION=0.9

# Leave QWEN3_ASR_MODEL empty for automatic selection.
# Supported values: qwen3-asr-0.6b, qwen3-asr-1.7b
# QWEN3_ASR_MODEL=

# -----------------------------------------------------------------------------
# Model cache behavior.
# Default: download missing models at startup.
# -----------------------------------------------------------------------------
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com
