# Qwen3-ASR environment
# Copy to .env and edit only the values you need to change.

# -----------------------------------------------------------------------------
# Public endpoint and auth.
# -----------------------------------------------------------------------------
# NGINX_PORT controls the host port used by docker-compose.
NGINX_PORT=17003

# Leave empty to disable authentication.
# API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Runtime selection.
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0

# Leave QWEN3_ASR_MODEL empty for automatic selection.
# Supported values: qwen3-asr-0.6b, qwen3-asr-1.7b
# The unified docker-compose.realtime.yml deployment defaults to 0.6B; this setting overrides it.
# QWEN3_ASR_MODEL=

# -----------------------------------------------------------------------------
# Model cache behavior.
# Default: download missing models at startup.
# -----------------------------------------------------------------------------
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com

# Unified GPU deployment manages R2T2_URL internally (127.0.0.1:8001).
# Only set a remote URL when running a separate API outside this deployment.
# R2T2_INTERNAL_TOKEN=
# ASR_GPU=1
# ASR_PORT=4174
# R2T2_MAX_SESSIONS=4
# R2T2_GPU_MEMORY_UTILIZATION=0.12
# QWEN_GPU_MEMORY_UTILIZATION=0.08
# QWEN_FORCE_ALIGNER_GPU_MEMORY_UTILIZATION=0.06
