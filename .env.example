# Single-container Qwen3-ASR runtime

# Public API
# API_KEY=replace-me
# QWEN3_ASR_API_HOST=0.0.0.0
# QWEN3_ASR_API_PORT=17003

# Customer-provided Qwen model
# QWEN_MODEL_SOURCE=/root/.cache/huggingface/hub/models--Qwen--Qwen3-ASR-1.7B/snapshots/7278e1e70fe206f11671096ffdd38061171dd6e5
# QWEN_ASCEND_MODEL_PATH=/workspace/hf_models/Qwen3-ASR-1.7B
# QWEN_COPY_PROGRESS_INTERVAL_SEC=0.2

# Same-container vLLM
# QWEN_VLLM_HOST=127.0.0.1
# QWEN_VLLM_PORT=17004
# QWEN_VLLM_SERVED_MODEL=qwen3-asr
# QWEN_VLLM_TIMEOUT_SEC=3600
# QWEN_VLLM_STARTUP_TIMEOUT_SEC=600
# QWEN_ASCEND_TENSOR_PARALLEL_SIZE=1
# QWEN_ASCEND_MAX_MODEL_LEN=4096
# QWEN_ASCEND_MEMORY_UTILIZATION=0.9

# Pinned base image used when building the delivery artifact
# VLLM_ASCEND_IMAGE=quay.io/ascend/vllm-ascend@sha256:9008b47081282612abfe4d28069ce34436752c980fd06f7599343213205ce64d
